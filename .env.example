# PostgreSQL (Supabase, Neon, or another managed PostgreSQL provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Microsoft Entra ID: single tenant, Prezensa organization
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Optional one-time first ADMIN credentials. Set both before the first login.
# The account is created only when the database has no ADMIN; existing accounts are never changed.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
