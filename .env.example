# PostgreSQL (Supabase, Neon, or another managed PostgreSQL provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Microsoft Entra ID: single tenant, Prezensa organization
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Comma-separated email addresses allowed to bootstrap as Admin on first login.
# Configure before the first production login; role changes should then be made in the database/admin UI.
PREZENSA_ADMIN_EMAILS="admin@prezensa.com"
